{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(aws:*)",
      "Bash(./build-and-push.ps1:*)",
      "Bash(pwsh:*)",
      "Bash(powershell:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/main:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/credentials)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(terraform:*)",
      "Bash(npm publish:*)",
      "Bash(git push origin master:*)",
      "Read(./**/id_rsa*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git show:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker image inspect:*)",
      "Bash(./scripts/verify-injections.sh:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npx playwright:*)",
      "Bash(node --check:*)",
      "Bash(python3:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ]
  },
  "_comment": "Guardrails for unattended runs. Deny wins over allow. The AWS CLI and build-and-push.ps1 are the ones that matter here: they reach a live booking service. Denying them outright is worth more than asking."
}
