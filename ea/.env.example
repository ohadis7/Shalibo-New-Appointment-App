# ── Shalibo Wellness — EA Local Dev Environment ─────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────

# Port mappings (change if ports conflict on your machine)
NGINX_PORT=80
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
SWAGGER_UI_PORT=8000
BAIKAL_PORT=8100
OPENLDAP_PORT=389
OPENLDAP_SSL_PORT=636
PHPLDAPADMIN_PORT=8200

# MySQL credentials (used by EA's config-sample.php)
DB_HOST=127.0.0.1
DB_NAME=easyappointments
DB_USERNAME=root
DB_PASSWORD=secret

# Resend SMTP (transactional email — password reset etc.)
# Get your API key from https://resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here

# MongoDB Atlas (shared provider email connector)
# Get your connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DATABASE=your_database_name_here
